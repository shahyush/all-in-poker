# All In — environment template (no secrets here; never commit real values)

# --- Edge Function `api` (set in Supabase: Edge Functions → Secrets) ---
# GROUP_PASSWORD        bootstrap group password; used only until the first player is admitted, then the hashed
#                       password in group_settings is authoritative and the owner can rotate it in the app
# ALLIN_APP_ORIGIN      optional comma list of allowed browser origins (default: project origin + https://shahyush.github.io)
# ALLIN_APP_URL         optional redirect target for the retired /functions/v1/app function
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# --- Local Node dev server (server/src/node/dev-server.ts) ---
ALLIN_DB_URL=postgres://postgres@127.0.0.1:54329/allin_dev   # dev server database; the test suite uses allin_test
ALLIN_ADMIN_DB_URL=postgres://postgres@127.0.0.1:54329/postgres
ALLIN_GROUP_PASSWORD=change-me
ALLIN_PORT=8787
# ALLIN_JOB_KEY=        optional; otherwise read from app_settings.job_key
# ALLIN_TICK_MS=1000

# --- PWA build (web/.env.example has the full list) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
