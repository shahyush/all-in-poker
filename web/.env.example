# Production build (GitHub Pages). Public values only: the publishable key is safe in a browser with RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: base path when hosting somewhere other than /all-in-poker/
# VITE_BASE=/
# Local development against the Node dev server instead of Supabase (never set in production)
# VITE_DEV_API=http://127.0.0.1:8787
